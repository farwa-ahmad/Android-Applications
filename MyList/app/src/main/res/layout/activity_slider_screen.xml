<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlSlider"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_list">

    <TextView
        android:id="@+id/tvThanksFor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tvMyList"
        android:layout_centerHorizontal="true"
        android:text="@string/onboarding_thanks"
        android:textColor="@color/secondary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvMyList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/ivLogo"
        android:layout_centerHorizontal="true"
        android:fontFamily="casual"
        android:paddingBottom="50dp"
        android:text="@string/app_name"
        android:textColor="@color/secondary"
        android:textSize="35sp" />

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/app_logo_description"
        android:src="@drawable/logo" />

    <TextView
        android:id="@+id/tvDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ivLogo"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:paddingHorizontal="40dp"
        android:paddingTop="50dp"
        android:text="@string/onboarding_details"
        android:textColor="@color/secondary"
        android:textSize="18sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:minHeight="48dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/next"
        android:textAllCaps="false"
        android:textColor="@color/secondary"
        android:textSize="16sp"
        app:backgroundTint="@color/secondary"
        app:cornerRadius="24dp" />

</RelativeLayout>
