rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validTask(data) {
      return data.keys().hasAll(['task', 'status', 'time'])
             && data.keys().hasOnly(['task', 'due', 'dueTime', 'status', 'time'])
             && data.task is string
             && data.task.size() > 0
             && data.task.size() <= 500
             && data.get('due', '') is string
             && (
               data.get('due', '') == ''
               || data.get('due', '').matches(
                 '^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'
               )
             )
             && data.get('dueTime', '') is string
             && data.get('dueTime', '').size() <= 5
             && (
               data.get('dueTime', '') == ''
               || (
                 data.get('due', '') != ''
                 && data.get('dueTime', '').matches(
                   '^([01][0-9]|2[0-3]):[0-5][0-9]$'
                 )
               )
             )
             && data.status is int
             && (data.status == 0 || data.status == 1)
             && data.time is timestamp;
    }

    match /users/{userId}/tasks/{taskId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
                    && validTask(request.resource.data);

      allow update: if isOwner(userId)
                    && validTask(request.resource.data)
                    && request.resource.data.time == resource.data.time;

      allow delete: if isOwner(userId);
    }
  }
}
